# Local package storage defaults. These credentials are for Wrangler only.
ENVIRONMENT=development
EXTENSION_PACKAGES_MODE=local
EXTENSION_PACKAGES_BASE_URL=http://127.0.0.1:8787/extensions/v2
EXTENSION_PACKAGES_S3_ENDPOINT=http://127.0.0.1:8787/cdn-cgi/local/r2/s3/
EXTENSION_PACKAGES_S3_BUCKET=extension-packages-local
EXTENSION_PACKAGES_S3_ACCESS_KEY_ID=local-access-key
EXTENSION_PACKAGES_S3_SECRET_ACCESS_KEY=local-secret-key
EXTENSION_ASSETS_S3_ENDPOINT=http://127.0.0.1:8787/cdn-cgi/local/r2/s3/
EXTENSION_ASSETS_S3_BUCKET=extension-assets-local
EXTENSION_ASSETS_S3_ACCESS_KEY_ID=local-access-key
EXTENSION_ASSETS_S3_SECRET_ACCESS_KEY=local-secret-key
EXTENSION_ASSETS_PUBLIC_URL=http://127.0.0.1:8787/cdn-cgi/local/r2/public/extension-assets-local
