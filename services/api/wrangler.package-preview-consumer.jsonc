{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api-package-preview-consumer",
  "main": "src/app/package-preview-consumer.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "placement": { "mode": "smart" },
  "vars": {
    "ENVIRONMENT": "preview",
    "EXTENSION_PACKAGES_MODE": "enabled"
  },
  "d1_databases": [
    {
      "binding": "DB_EXTENSIONS",
      "database_id": "951c630e-49ed-47d2-9eea-ae2aa2293be5"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EXTENSION_PACKAGE_QUEUE",
        "queue": "extension-packages-preview"
      }
    ],
    "consumers": [
      {
        "queue": "extension-packages-preview",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  },
  "triggers": { "crons": ["0 * * * *"] }
}
