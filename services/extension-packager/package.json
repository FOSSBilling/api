{
  "name": "@fossbilling/extension-packager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.dev.vars --env-file=../../libraries/extension-packaging/development.env scripts/extension-packager-dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:netlify": "esbuild netlify/functions/extension-packager.ts --bundle --platform=node --format=esm --target=node24 --external:sharp --external:@zeropress/svg-hush/* --outdir=.netlify/functions-source --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@fossbilling/extension-packaging": "*",
    "@fossbilling/logging": "*",
    "@zeropress/svg-hush": "0.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@zip.js/zip.js": "2.25.0"
  }
}
