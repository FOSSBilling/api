{
  "name": "api",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "cf-deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate:extensions": "drizzle-kit generate --config drizzle.extensions.config.ts",
    "db:generate:central-alerts": "drizzle-kit generate --config drizzle.central-alerts.config.ts",
    "db:migrate:extensions-v2:local": "wrangler d1 migrations apply DB_EXTENSIONS --local",
    "db:migrate:extensions-v2:remote": "wrangler d1 migrations apply DB_EXTENSIONS --remote",
    "db:migrate:central-alerts:local": "wrangler d1 migrations apply DB_CENTRAL_ALERTS --local",
    "db:migrate:central-alerts:remote": "wrangler d1 migrations apply DB_CENTRAL_ALERTS --remote",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:all": "npm run test && npm run test:node",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@octokit/graphql": "^9.0.4",
    "@octokit/request": "^10.0.13",
    "@scalar/hono-api-reference": "^0.11.12",
    "badge-maker": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "semver": "^7.8.5",
    "spdx-license-ids": "^3.0.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.1",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
