{
  "name": "api",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "cf-deploy": "npm run db:migrate:all:remote && wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate:extensions": "drizzle-kit generate --config drizzle.extensions.config.ts",
    "db:generate:central-alerts": "drizzle-kit generate --config drizzle.central-alerts.config.ts",
    "db:migrate:extensions-v2:local": "wrangler d1 migrations apply DB_EXTENSIONS --local",
    "db:migrate:extensions-v2:remote": "wrangler d1 migrations apply DB_EXTENSIONS --remote",
    "db:migrate:central-alerts:local": "wrangler d1 migrations apply DB_CENTRAL_ALERTS --local",
    "db:migrate:central-alerts:remote": "wrangler d1 migrations apply DB_CENTRAL_ALERTS --remote",
    "db:migrate:all:local": "npm run db:migrate:extensions-v2:local && npm run db:migrate:central-alerts:local",
    "db:migrate:all:remote": "npm run db:migrate:extensions-v2:remote && npm run db:migrate:central-alerts:remote",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:all": "npm run test && npm run test:node",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "packages:setup": "tsx scripts/package-demo.ts setup",
    "packages:dev": "wrangler dev --env packages-local --local --ip 127.0.0.1 --port 8789 --persist-to .wrangler/package-demo",
    "packages:demo": "tsx scripts/package-demo.ts exercise"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@octokit/graphql": "9.0.5",
    "@octokit/request": "10.0.16",
    "@scalar/hono-api-reference": "0.12.18",
    "@zeropress/svg-hush": "0.1.1",
    "@zip.js/zip.js": "2.24.0",
    "aws4fetch": "1.0.20",
    "badge-maker": "6.0.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "semver": "7.8.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
