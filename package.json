{
  "name": "@fossbilling/services",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "services/*",
    "libraries/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fossbilling/api",
    "extension-packager:dev": "npm run dev --workspace @fossbilling/extension-packager",
    "cf-typegen": "npm run cf-typegen --workspace @fossbilling/api",
    "cf-deploy": "npm run cf-deploy --workspace @fossbilling/api",
    "build:api": "npm run build --workspace @fossbilling/api",
    "test": "npm test --workspaces",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-preview": "npm run cf-preview --workspace @fossbilling/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-istanbul": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
