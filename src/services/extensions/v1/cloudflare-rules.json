[
  {
    "name": "URL Rewrite Rules",
    "kind": "zone",
    "phase": "http_request_transform",
    "rules": [
      {
        "ref": "extensions_v1_badge_version",
        "description": "Extensions v1 version badge; retire 2027-02-05",
        "expression": "(http.host eq \"api.fossbilling.net\" and http.request.method in {\"GET\" \"HEAD\"} and http.request.uri.path wildcard \"/extensions/v1/*/badges/version\")",
        "action": "rewrite",
        "action_parameters": {
          "uri": {
            "path": {
              "expression": "wildcard_replace(http.request.uri.path, \"/extensions/v1/*/badges/version\", \"/extensions/v2/extensions/${1}/badges/version\")"
            }
          }
        },
        "enabled": true
      },
      {
        "ref": "extensions_v1_badge_license",
        "description": "Extensions v1 license badge; retire 2027-02-05",
        "expression": "(http.host eq \"api.fossbilling.net\" and http.request.method in {\"GET\" \"HEAD\"} and http.request.uri.path wildcard \"/extensions/v1/*/badges/license\")",
        "action": "rewrite",
        "action_parameters": {
          "uri": {
            "path": {
              "expression": "wildcard_replace(http.request.uri.path, \"/extensions/v1/*/badges/license\", \"/extensions/v2/extensions/${1}/badges/license\")"
            }
          }
        },
        "enabled": true
      },
      {
        "ref": "extensions_v1_badge_min_fossbilling_version",
        "description": "Extensions v1 min_fossbilling_version badge; retire 2027-02-05",
        "expression": "(http.host eq \"api.fossbilling.net\" and http.request.method in {\"GET\" \"HEAD\"} and http.request.uri.path wildcard \"/extensions/v1/*/badges/min_fossbilling_version\")",
        "action": "rewrite",
        "action_parameters": {
          "uri": {
            "path": {
              "expression": "wildcard_replace(http.request.uri.path, \"/extensions/v1/*/badges/min_fossbilling_version\", \"/extensions/v2/extensions/${1}/badges/fossbilling\")"
            }
          }
        },
        "enabled": true
      }
    ]
  },
  {
    "name": "Response Header Transform Rules",
    "kind": "zone",
    "phase": "http_response_headers_transform",
    "rules": [
      {
        "ref": "extensions_v1_sunset",
        "description": "Extensions v1 EOL 2027-02-05; remove with v1 service",
        "expression": "(http.host eq \"api.fossbilling.net\" and (raw.http.request.uri.path eq \"/extensions/v1\" or starts_with(raw.http.request.uri.path, \"/extensions/v1/\")))",
        "action": "rewrite",
        "action_parameters": {
          "headers": {
            "deprecation": {
              "operation": "set",
              "value": "@1793836800"
            },
            "sunset": {
              "operation": "set",
              "value": "Fri, 05 Feb 2027 00:00:00 GMT"
            },
            "link": {
              "operation": "add",
              "value": "<https://api.fossbilling.net/extensions/v2/docs>; rel=\"successor-version\""
            }
          }
        },
        "enabled": true
      }
    ]
  }
]
