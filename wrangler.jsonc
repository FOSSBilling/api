{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [],
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "placement": {
    "mode": "smart"
  },
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production",
    // Enable only after the private image bucket and B2 secrets are provisioned.
    "EXTENSION_PACKAGES_MODE": "disabled",
    "EXTENSION_PACKAGES_BASE_URL": "https://api.fossbilling.net/extensions/v2",
    "EXTENSION_PACKAGES_S3_ENDPOINT": "https://s3.eu-central-003.backblazeb2.com",
    "EXTENSION_PACKAGES_S3_REGION": "eu-central-003",
    "EXTENSION_PACKAGES_S3_BUCKET": "fb-extensions-packages",
    "EXTENSION_PACKAGES_S3_PREFIX": "production",
    "EXTENSION_ASSETS_S3_ENDPOINT": "https://s3.eu-central-003.backblazeb2.com",
    "EXTENSION_ASSETS_S3_REGION": "eu-central-003",
    "EXTENSION_ASSETS_S3_BUCKET": "fb-extensions-assets",
    "EXTENSION_ASSETS_PUBLIC_URL": "https://extensions-assets.fossbilling.net",
    "EXTENSIONS_RETENTION_MODE": "dry-run",
    "EXTENSIONS_V2_EMAIL_PROVIDER": "mxroute",
    "EXTENSIONS_V2_MXROUTE_SERVER": "wednesday.mxrouting.net",
    "EXTENSIONS_V2_MXROUTE_USERNAME": "extensions@fossbilling.org",
    "M2M_ISSUER": "https://auth.fossbilling.net",
    "M2M_JWKS_URL": "https://auth.fossbilling.net/.well-known/jwks.json",
    "M2M_AUDIENCE": "https://api.fossbilling.net"
  },
  "routes": [
    {
      "pattern": "api.fossbilling.net",
      "zone_name": "fossbilling.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_CENTRAL_ALERTS",
      "database_id": "3a47f7fd-5eda-4754-9594-9de809ad7823",
      "migrations_dir": "src/services/central-alerts/v1/db/migrations"
    },
    {
      "binding": "DB_EXTENSIONS",
      "database_id": "b99e8d34-4856-4f92-837d-5413869d3d83",
      "migrations_dir": "src/services/extensions/v2/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "2750aba268824ff28fc8171cc75f4215"
    },
    {
      "binding": "CACHE_KV",
      "id": "0771957093ae481b9cd974ffa83f8263"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "EXTENSION_PACKAGE_QUEUE", "queue": "extension-packages" }
    ],
    "consumers": [
      {
        "queue": "extension-packages",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  },
  "images": { "binding": "PACKAGE_IMAGES", "remote": false },
  "r2_buckets": [
    {
      "binding": "DOWNLOAD_BUCKET",
      "bucket_name": "fossbilling-download"
    },
    {
      // Private prepared icons, including pending submissions. Provision before deployment.
      "binding": "EXTENSION_IMAGE_BUCKET",
      "bucket_name": "fb-extensions-private-images"
    }
  ],
  "services": [
    {
      // Private service binding to the extensions site worker. Used by
      // revalidateExtensions() to purge the site's CDN-cached extension pages
      // after content mutations — see src/services/extensions/v2/revalidate.ts.
      "binding": "EXTENSIONS_FRONTEND",
      "service": "extensions"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PREVIEW_GITHUB_BUDGET", "class_name": "PreviewGitHubBudget" }
    ]
  },
  "migrations": [
    {
      "tag": "preview-github-budget-v1",
      "new_sqlite_classes": ["PreviewGitHubBudget"]
    }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    {
      "name": "EXTENSION_WRITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "PROFILE_CREATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "env": {
    "packages-local": {
      "queues": {
        "producers": [
          {
            "binding": "EXTENSION_PACKAGE_QUEUE",
            "queue": "extension-packages-local"
          }
        ],
        "consumers": [
          {
            "queue": "extension-packages-local",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 1
          }
        ]
      },
      "images": { "binding": "PACKAGE_IMAGES", "remote": false },
      "routes": [],
      "vars": {
        "ENVIRONMENT": "local",
        "EXTENSIONS_RETENTION_MODE": "dry-run",
        "M2M_ISSUER": "https://auth.fossbilling.net",
        "M2M_JWKS_URL": "https://auth.fossbilling.net/.well-known/jwks.json",
        "M2M_AUDIENCE": "https://api.fossbilling.net",
        "EXTENSIONS_V2_EMAIL_PROVIDER": "disabled",
        "EXTENSIONS_V2_MXROUTE_SERVER": "",
        "EXTENSIONS_V2_MXROUTE_USERNAME": "",
        "EXTENSION_PACKAGES_MODE": "local",
        "EXTENSION_PACKAGES_BASE_URL": "http://localhost:8789/extensions/v2"
      },
      "d1_databases": [
        {
          "binding": "DB_CENTRAL_ALERTS",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "src/services/central-alerts/v1/db/migrations"
        },
        {
          "binding": "DB_EXTENSIONS",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "src/services/extensions/v2/db/migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "00000000000000000000000000000001" },
        { "binding": "CACHE_KV", "id": "00000000000000000000000000000002" }
      ],
      "r2_buckets": [
        { "binding": "DOWNLOAD_BUCKET", "bucket_name": "downloads-local" },
        {
          "binding": "EXTENSION_PACKAGE_BUCKET",
          "bucket_name": "extension-packages-local"
        },
        {
          "binding": "EXTENSION_IMAGE_BUCKET",
          "bucket_name": "extension-images-local"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PREVIEW_GITHUB_BUDGET",
            "class_name": "PreviewGitHubBudget"
          }
        ]
      },
      "services": [
        { "binding": "EXTENSIONS_FRONTEND", "service": "extensions" }
      ],
      "ratelimits": [
        {
          "name": "EXTENSION_WRITE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 50, "period": 60 }
        },
        {
          "name": "PROFILE_CREATION_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 3, "period": 60 }
        }
      ]
    }
  }
}
