{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "placement": {
    "mode": "smart"
  },
  "preview_urls": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.fossbilling.net",
      "zone_name": "fossbilling.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_CENTRAL_ALERTS",
      "database_id": "3a47f7fd-5eda-4754-9594-9de809ad7823",
      "migrations_dir": "src/services/central-alerts/v1/db/migrations"
    },
    {
      "binding": "DB_EXTENSIONS",
      "database_id": "b99e8d34-4856-4f92-837d-5413869d3d83",
      "migrations_dir": "src/services/extensions/v2/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "2750aba268824ff28fc8171cc75f4215"
    },
    {
      "binding": "CACHE_KV",
      "id": "0771957093ae481b9cd974ffa83f8263"
    }
  ],
  // Backs previews/v1's `main` route. Pre-existing bucket (created
  // 2024-09-27) that FOSSBilling/FOSSBilling's ci.yml already syncs the
  // main-branch preview zip to, served publicly at
  // download.fossbilling.org - not previously bound to any Worker.
  // Double-check in the Cloudflare dashboard that this is in fact the
  // bucket behind that custom domain before relying on it in production.
  "r2_buckets": [
    {
      "binding": "PREVIEW_BUCKET",
      "bucket_name": "fossbilling"
    }
  ],
  "ratelimits": [
    {
      "name": "PROFILE_CREATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
